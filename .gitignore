state/
*.log
# per-machine permission overrides (e.g. re-denying git push). build does `git add -A`,
# so without this an untracked local settings file WOULD be committed.
.claude/settings.local.json
.DS_Store
node_modules/
__pycache__/
dist/
dist-mock/
coverage/
# secrets -- never commit. build does `git add -A`, so an untracked .env WOULD be committed.
.env
.env.*
!.env.example
# Rust and Tauri build output (generated ACL schemas are rebuilt by tauri-build)
target/
src-tauri/target/
src-tauri/gen/schemas/
# local Python environment for the fixture generator
.venv/
# Playwright output and the Playwright MCP's working files
playwright-report/
test-results/
.playwright-mcp/
# outputs of the fixture generator and the reference detector (regenerated on demand)
samples/fixture/out/
samples/proto/out_r2/
samples/proto/report_r2.json

# per-feature worktrees used for parallel builds
.worktrees/
