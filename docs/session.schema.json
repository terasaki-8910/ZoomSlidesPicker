{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoomslidespicker.local/session.schema.json",
  "title": "ZoomSlidesPicker session.json",
  "description": "One session's record (SPEC.md > 出力). Written after every change, so it is valid mid-session and after a crash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "app_version", "started_at", "ended_at", "source", "region", "settings", "captures", "revisits", "events", "pdf"],
  "properties": {
    "schema": { "const": 1 },
    "app_version": { "type": "string", "minLength": 1 },
    "started_at": { "$ref": "#/$defs/time" },
    "ended_at": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "app", "title", "platform", "file"],
      "properties": {
        "kind": { "enum": ["window", "mp4"] },
        "app": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "platform": { "enum": ["macos", "windows", "linux"] },
        "file": { "type": ["string", "null"] }
      }
    },
    "region": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "$ref": "#/$defs/fraction" },
            "y": { "$ref": "#/$defs/fraction" },
            "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "h": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interval_s"],
      "properties": { "interval_s": { "type": "number", "minimum": 0.5, "maximum": 5 } }
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "file", "t_content", "t_saved", "reason", "width", "height"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "pattern": "^[0-9]{3,}_[0-9]{2,}-[0-9]{2}-[0-9]{2}\\.png$" },
          "t_content": { "type": "number", "minimum": 0 },
          "t_saved": { "type": "number", "minimum": 0 },
          "reason": { "enum": ["settled", "manual", "end"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "revisits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "matches"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "matches": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "type"],
        "properties": {
          "t": { "type": "number", "minimum": 0 },
          "type": { "enum": ["paused", "resumed", "blank", "window_lost", "window_back", "undo"] }
        }
      }
    },
    "pdf": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "pages", "rebuilt_at"],
          "properties": {
            "file": { "const": "slides.pdf" },
            "pages": { "type": "integer", "minimum": 1 },
            "rebuilt_at": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }
          }
        }
      ]
    }
  },
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$"
    },
    "fraction": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
